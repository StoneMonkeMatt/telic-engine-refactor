  const rotationSensitivity = Object.fromEntries(
    METRICS.map(metric => {
      const values = summaries.map(summary => summary.estimators[metric]);
      const intervalStatuses = summaries.map(summary => intervalSign(summary.uncertainty[metric]));
      return [
        metric,
        {
          meanAcrossRotations: mean(values),
          minimum: Math.min(...values),
          maximum: Math.max(...values),
          negativePointEstimates: values.filter(value => value < 0).length,
          zeroPointEstimates: values.filter(value => value === 0).length,
          positivePointEstimates: values.filter(value => value > 0).length,
          negativeIntervals: intervalStatuses.filter(value => value === 'negative').length,
          crossingIntervals: intervalStatuses.filter(value => value === 'crosses-zero').length,
          positiveIntervals: intervalStatuses.filter(value => value === 'positive').length,
          byRotation: summaries.map(summary => ({
            rotation: summary.rotation,
            value: summary.estimators[metric],
            pointSign: sign(summary.estimators[metric]),
            interval95: summary.uncertainty[metric].interval95,
            intervalSign: intervalSign(summary.uncertainty[metric]),
          })),
        },
      ];
    }),
  );

  const dynamics = {
    rotationsWithMechanisticTimingEndpoint: summaries.filter(
      summary => summary.dynamics.mechanisticTimingEndpointMet,
    ).length,
    totalComparablePreStateSteps: summaries.reduce(
      (sum, summary) => sum + summary.dynamics.comparablePreStateSteps,
      0,
    ),
    totalChangedWinnerSteps: summaries.reduce(
      (sum, summary) => sum + summary.dynamics.changedWinnerSteps,
      0,
    ),
    totalChangedAdmissionSteps: summaries.reduce(
      (sum, summary) => sum + summary.dynamics.changedAdmissionSteps,
      0,
    ),
    totalAcceptedTimingInducedActions: summaries.reduce(
      (sum, summary) => sum + summary.dynamics.acceptedTimingInducedActions,
      0,
    ),
    totalActiveBranchRuns: summaries.reduce(
      (sum, summary) => sum + summary.scale.activeTimingBranchRuns,
      0,
    ),
    totalAcceptedTraceRecords: summaries.reduce(
      (sum, summary) => sum + summary.scale.acceptedTraceRecords,
      0,
    ),
  };

  const primary = ensembleUncertainty.deltaRealMinusShamZ1;
  const interference = ensembleUncertainty.timingFeedbackInteraction;
  const trueHistoryAdvantageEstablished = primary.interval95[0] > 0;
  const trueHistoryHarmEstablished = primary.interval95[1] < 0;
  const feedbackInterferenceRobust = interference.interval95[1] < 0;
  const feedbackSynergyRobust = interference.interval95[0] > 0;

  const interpretation = trueHistoryAdvantageEstablished
    ? 'Across the complete cyclic-rotation sham ensemble, true chronology produced a pair-generalised repair advantage under feedback.'
    : trueHistoryHarmEstablished
      ? 'Across the complete cyclic-rotation sham ensemble, true chronology produced lower pair-generalised repair under feedback.'
      : feedbackInterferenceRobust
        ? 'True chronology did not establish a repair advantage over the complete sham ensemble, while the negative timing-by-feedback interaction remained pair-generalised across the ensemble.'
        : feedbackSynergyRobust
          ? 'True chronology did not establish a direct repair advantage, but feedback produced a positive pair-generalised timing interaction across the complete sham ensemble.'
          : 'Temporal order remained mechanistically active across the rotation ensemble, but neither a true-history repair advantage nor a stable feedback interaction was established.';

  const nextExperiment = trueHistoryAdvantageEstablished
    ? 'EMERGE-CARRIER-004: preregister held-out generalisation across fresh seeds, microstates, wounds, inventories and ontology perturbations.'
    : feedbackInterferenceRobust
