      const pair = summary.pairEffects.find(entry => entry.pairId === pairId);
      if (!pair) throw new Error(`Rotation ${summary.rotation} is missing ${pairId}.`);
      return pair;
    });
    const output: PairEffect = {
      pairId,
      deltaRealMinusShamZ0: 0,
      deltaRealMinusShamZ1: 0,
      timingFeedbackInteraction: 0,
      stateSpecificTimingZ0: 0,
      stateSpecificTimingZ1: 0,
      stateTimingFeedbackInteraction: 0,
    };
    for (const metric of METRICS) output[metric] = mean(rotationPairs.map(pair => pair[metric]));
    return output;
  });

  const ensembleUncertainty = Object.fromEntries(
    METRICS.map(metric => [metric, interval(ensemblePairEffects.map(pair => pair[metric]))]),
  ) as Record<Metric, Interval>;
  const ensembleEstimators = Object.fromEntries(
    METRICS.map(metric => [metric, ensembleUncertainty[metric].mean]),
  ) as Record<Metric, number>;

  const leaveOneRotationOut = summaries.map(omitted => {
    const retained = summaries.filter(summary => summary.rotation !== omitted.rotation);
    const pairEffects = pairIds.map(pairId => {
      const entry = { pairId } as PairEffect;
      for (const metric of METRICS) {
        entry[metric] = mean(retained.map(summary => summary.pairEffects.find(pair => pair.pairId === pairId)![metric]));
      }
      return entry;
    });
    return {
      omittedRotation: omitted.rotation,
      deltaRealMinusShamZ1: interval(pairEffects.map(pair => pair.deltaRealMinusShamZ1)),
      timingFeedbackInteraction: interval(pairEffects.map(pair => pair.timingFeedbackInteraction)),
    };
  });

  const rotationRows = summaries.map(summary => ({
    rotation: summary.rotation,
    estimators: summary.estimators,
    uncertainty: summary.uncertainty,
    dynamics: summary.dynamics,
