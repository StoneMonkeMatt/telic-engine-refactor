                capsule.capsuleId,
              ),
            );
            if (!referenceHash) {
              throw new Error(
                `Missing Carrier-002C active reference for ${pair.pairId}/${microstateSource}/${capsule.capsuleId}/replicate=${lesion.replicate}/Z=${feedback}.`,
              );
            }

            if (runMode === 'neutrality') {
              for (const timingMode of ['real', 'sham'] as const) {
                const schedule = timingMode === 'real' ? schedules.real : schedules.sham;
                const neutral = runBranch(
                  config,
                  codex,
                  pair.pairId,
                  microstateSource,
                  checkpoint,
                  lesion,
                  feedback,
                  capsule,
                  timingMode,
                  0,
                  schedule,
                  emaAlpha,
                  historyWindow,
                );
                const neutralHash = stableHash(neutral.projection);
                neutralityComparisons++;
                if (neutralHash !== referenceHash) {
                  neutralityMismatches++;
                  throw new Error(
                    `Carrier-003B schedule-plumbing neutrality mismatch at ${pair.pairId}/${microstateSource}/${capsule.capsuleId}/${timingMode}/rotation=${rotation}/replicate=${lesion.replicate}/Z=${feedback}.`,
                  );
                }
              }
            } else {
              const real = runBranch(
                config,
                codex,
                pair.pairId,
                microstateSource,
                checkpoint,
                lesion,
                feedback,
                capsule,
                'real',
                1,
                schedules.real,
                emaAlpha,
                historyWindow,
              );
              const sham = runBranch(
                config,
                codex,
                pair.pairId,
                microstateSource,
                checkpoint,
                lesion,
                feedback,
                capsule,
                'sham',
                1,
                schedules.sham,
                emaAlpha,
                historyWindow,
              );
              const pairedDiagnostics = compareRuns(sham, real);

              branches.push({
                pairId: pair.pairId,
                microstateSource,
                replicate: lesion.replicate,
                feedback,
                capsuleId: capsule.capsuleId,
                timingMode: 'real',
                timingActive: 1,
                branchSeed: lesion.branchSeed,
                projection: real.projection,
                diagnostics: real.diagnostics,
                projectionSha256: stableHash(real.projection),
                pairedDiagnostics,
              });
              branches.push({
                pairId: pair.pairId,
                microstateSource,
                replicate: lesion.replicate,
                feedback,
                capsuleId: capsule.capsuleId,
                timingMode: 'sham',
                timingActive: 1,
                branchSeed: lesion.branchSeed,
                projection: sham.projection,
                diagnostics: sham.diagnostics,
                projectionSha256: stableHash(sham.projection),
                pairedDiagnostics: null,
              });

              for (const trace of real.acceptedTrace) traceLines.push(JSON.stringify(trace));
              for (const trace of sham.acceptedTrace) traceLines.push(JSON.stringify(trace));
            }
          }
        }
      }
    }
  }

  if (runMode === 'neutrality') {
    const allScheduleReceipts: Record<string, unknown>[] = [];
    for (const carrierPair of capsules.frozen.pairs) {
      for (const capsule of [carrierPair.m0, carrierPair.m1]) {
        const real = normalizedHistory(capsule, 16);
        const shamReceipts = [];
        for (let shamRotation = 1; shamRotation <= 14; shamRotation++) {
          const sham = rotatePreterminal(real, shamRotation);
          if (JSON.stringify(sortedNumeric(real)) !== JSON.stringify(sortedNumeric(sham))) {
            throw new Error(`Rotation ${shamRotation} failed multiset equality for ${carrierPair.pairId}/${capsule.capsuleId}.`);
          }
          if (real[real.length - 1] !== sham[sham.length - 1]) {
            throw new Error(`Rotation ${shamRotation} failed terminal-anchor equality for ${carrierPair.pairId}/${capsule.capsuleId}.`);
          }
          if (JSON.stringify(real) === JSON.stringify(sham)) {
            throw new Error(`Rotation ${shamRotation} reproduced the real schedule for ${carrierPair.pairId}/${capsule.capsuleId}.`);
          }
          shamReceipts.push({ rotation: shamRotation, sha256: stableHash(sham) });
        }
        if (new Set(shamReceipts.map(entry => entry.sha256)).size !== 14) {
          throw new Error(`Carrier-003B did not produce 14 unique sham schedules for ${carrierPair.pairId}/${capsule.capsuleId}.`);
        }
        allScheduleReceipts.push({
          pairId: carrierPair.pairId,
          capsuleId: capsule.capsuleId,
          scheduleLength: real.length,
          terminalAnchor: real[real.length - 1],
          realSha256: stableHash(real),
          multisetSha256: stableHash(sortedNumeric(real)),
          shams: shamReceipts,
        });
      }
    }
    const neutralitySummary = {
      schemaVersion: 'emerge-carrier-003b-neutrality-v1',
      experimentId: 'EMERGE-CARRIER-003B',
      generatedAt: new Date().toISOString(),
      runMode,
      validationRotation: rotation,
      sourceSelectorSha256: panel.selectorSha256,
      capsuleSelectorSha256: capsules.capsuleSelectorSha256,
      carrier002CReferenceSha256: stableHash(carrier002C.branches),
      neutrality: {
        comparisons: neutralityComparisons,
        mismatches: neutralityMismatches,
        passed: neutralityMismatches === 0,
      },
      scheduleValidation: {
        rotations: Array.from({ length: 14 }, (_, index) => index + 1),
        capsuleSchedules: allScheduleReceipts.length,
        allRotationsPreserveMultisetDurationAndTerminalAnchor: true,
        allRotationsUniqueAndNonIdentity: true,
      },
      scheduleReceipts: allScheduleReceipts,
    };
    const neutralityManifest = {
      schemaVersion: 'emerge-carrier-003b-neutrality-manifest-v1',
      experimentId: neutralitySummary.experimentId,
      summarySha256: stableHash(neutralitySummary),
      neutralityPassed: neutralitySummary.neutrality.passed,
    };
    mkdirSync(dirname(summaryPath), { recursive: true });
    mkdirSync(dirname(tracePath), { recursive: true });
    mkdirSync(dirname(manifestPath), { recursive: true });
    writeFileSync(summaryPath, `${JSON.stringify(neutralitySummary, null, 2)}\n`, 'utf8');
    writeFileSync(tracePath, gzipSync('', { level: 9 }));
    writeFileSync(manifestPath, `${JSON.stringify(neutralityManifest, null, 2)}\n`, 'utf8');
    console.log(JSON.stringify({ neutrality: neutralitySummary.neutrality, scheduleValidation: neutralitySummary.scheduleValidation, manifest: neutralityManifest }, null, 2));
    return;
  }

  const cell = (
    capsuleId: CapsuleId,
    timingMode: TimingMode,
    timingActive: TimingActive,
    feedback: 0 | 1,
  ) => {
    const selected = branches.filter(
      branch =>
        branch.capsuleId === capsuleId &&
        branch.timingMode === timingMode &&
        branch.timingActive === timingActive &&
        branch.feedback === feedback,
    );
    return {
      capsuleId,
      timingMode,
      timingActive,
      feedback,
      n: selected.length,
      meanFinalTargetRecovery: mean(
        selected.map(branch => branch.projection.finalTargetRecovery),
      ),
      meanFinalCoherence: mean(
        selected.map(branch => branch.projection.finalCoherence),
      ),
    };
  };

  const cells = (['M0-unlatched', 'M1-latched'] as const).flatMap(capsuleId =>
    (['real', 'sham'] as const).flatMap(timingMode =>
      ([0, 1] as const).map(feedback =>
        cell(capsuleId, timingMode, 1, feedback),
      ),
    ),
  );

  const value = (
    capsuleId: CapsuleId,
    timingMode: TimingMode,
    feedback: 0 | 1,
  ): number =>
    cells.find(
      entry =>
        entry.capsuleId === capsuleId &&
        entry.timingMode === timingMode &&
        entry.timingActive === 1 &&
        entry.feedback === feedback,
    )!.meanFinalTargetRecovery;

  const deltaForFeedback = (feedback: 0 | 1) =>
    mean(
      (['M0-unlatched', 'M1-latched'] as const).map(
        capsuleId => value(capsuleId, 'real', feedback) - value(capsuleId, 'sham', feedback),
      ),
    );
  const thetaForFeedback = (feedback: 0 | 1) =>
    (value('M1-latched', 'real', feedback) - value('M1-latched', 'sham', feedback)) -
    (value('M0-unlatched', 'real', feedback) - value('M0-unlatched', 'sham', feedback));

  const deltaZ0 = deltaForFeedback(0);
